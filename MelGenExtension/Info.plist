<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>AudioComponents</key>
			<array>
				<dict>
					<key>description</key>
					<string>Generates melodic lines over a chord progression</string>
					<key>factoryFunction</key>
					<string>$(PRODUCT_MODULE_NAME).AudioUnitViewController</string>
					<key>manufacturer</key>
					<string>Enke</string>
					<key>name</key>
					<string>Enkerli: MelGen</string>
					<key>sandboxSafe</key>
					<true/>
					<!-- Component identity is the (type, subtype, manufacturer) triple, so
					     the subtype must stay unique across the suite. The Xcode template's
					     default was "Prst", which is Progression Studio's code: two
					     components sharing a triple means the host resolves either name to
					     whichever one it indexed, and loading Progression Studio in AUM
					     launched MelGen. Codes in use elsewhere: Dqau, Mcur, Pqf1, Prst,
					     RPEd, Rndc, Rsxp, VAne, Wksp. -->
					<key>subtype</key>
					<string>MlGn</string>
					<key>tags</key>
					<array>
						<string>MIDI Processor</string>
					</array>
					<key>type</key>
					<string>aumi</string>
					<key>version</key>
					<integer>67072</integer>
				</dict>
			</array>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.AudioUnit-UI</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).AudioUnitViewController</string>
	</dict>
</dict>
</plist>
